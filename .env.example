# PostgreSQL connection string used by Drizzle and Better Auth.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Random secret of at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Canonical origin of this deployment. Vercel URLs are detected automatically.
BETTER_AUTH_URL=http://localhost:3000

# Optional. Extra comma-separated origins allowed to call the auth endpoints.
# BETTER_AUTH_TRUSTED_ORIGINS=

# Optional. Required for the scheduled maintenance route; without it the route stays closed.
# CRON_SECRET=
